<Window x:Class="RResizer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Title="Пакетное изменение размеров изображений"
    Icon="rresizer.ico"
    WindowStyle="None"
    ResizeMode="CanResize"
    Width="620" Height="660"
    MinWidth="620" MinHeight="660"
    WindowStartupLocation="CenterScreen"
    Background="#F7F8FA"
    FontFamily="Segoe UI"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True" >
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="0"
            ResizeBorderThickness="6"
            GlassFrameThickness="0"
            CornerRadius="12"
            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
<Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#4A5568"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Margin="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E9ECF3"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CloseTitleBarButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FDE7E9"/>
                    <Setter Property="Foreground" Value="#C42B3A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <SolidColorBrush x:Key="Text" Color="#172033"/>
        <SolidColorBrush x:Key="Muted" Color="#718096"/>
        <SolidColorBrush x:Key="Border" Color="#DDE3EC"/>
        <SolidColorBrush x:Key="LogoPink" Color="#FF2F7D"/>
        <SolidColorBrush x:Key="LogoPurple" Color="#8B2BE2"/>
        <SolidColorBrush x:Key="LogoMint" Color="#59E9B0"/>
        <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FF2F7D" Offset="0"/>
            <GradientStop Color="#8B2BE2" Offset="0.5"/>
            <GradientStop Color="#59E9B0" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="Box" TargetType="TextBox">
            <Setter Property="Height" Value="46"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDE3EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="20,0,20,0"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OptionCheck" TargetType="CheckBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#52647B"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal"
                                    Height="28"
                                    Background="Transparent"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Border x:Name="Track"
                                    Width="34"
                                    Height="20"
                                    CornerRadius="10"
                                    Background="#D7DEE8"
                                    VerticalAlignment="Center">
                                <Ellipse x:Name="Thumb"
                                         Width="16"
                                         Height="16"
                                         Fill="White"
                                         HorizontalAlignment="Left"
                                         Margin="2,0,0,0"
                                         VerticalAlignment="Center"/>
                            </Border>

                            <ContentPresenter Margin="9,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </StackPanel>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.9"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Preset" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Background" Value="#EFF2F6"/>
            <Setter Property="Foreground" Value="#172033"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0E8F8"/>
                    <Setter Property="Foreground" Value="#6F24B8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>



    <Border Background="#F7F8FA" CornerRadius="12" SnapsToDevicePixels="True" ClipToBounds="True">
        <Grid Background="#F7F8FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#F7F8FA"
                BorderBrush="#DDE3EC"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                VerticalAlignment="Top">
            <Grid Margin="14,0,0,0" VerticalAlignment="Top" Height="44" ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="46"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
                       Source="rresizer.ico"
                       Width="32" Height="32"
                       Stretch="None"
                       SnapsToDevicePixels="True"
                       UseLayoutRounding="True"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"/>

                <TextBlock Grid.Column="1"
                           Text="Пакетное изменение размеров изображений"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#263142"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="2" Click="MinimizeButton_Click"
                        Style="{StaticResource TitleBarButtonStyle}" ToolTip="Свернуть" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Width="12" Height="1"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Stretch="Fill" Data="M 0,0 L 12,0 L 12,1 L 0,1 Z"/>
                </Button>
                <Button Grid.Column="3" Click="CloseButton_Click"
                        Style="{StaticResource CloseTitleBarButtonStyle}" ToolTip="Закрыть" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Canvas Width="12" Height="12">
                        <Line X1="1.5" Y1="1.5" X2="10.5" Y2="10.5"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"/>
                        <Line X1="10.5" Y1="1.5" X2="1.5" Y2="10.5"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"/>
                    </Canvas>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1">

        <Grid Margin="20,20,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*" MinHeight="190"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Ширина" FontSize="13" Foreground="#68738A"/>
                    <TextBox x:Name="WidthBox" Style="{StaticResource Box}" Margin="0,7,0,0"
                             PreviewTextInput="NumericInput"
                             DataObject.Pasting="NumericPaste"
                             TextChanged="SizeBoxChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Высота" FontSize="13" Foreground="#68738A"/>
                    <TextBox x:Name="HeightBox" Style="{StaticResource Box}" Margin="0,7,0,0"
                             PreviewTextInput="NumericInput"
                             DataObject.Pasting="NumericPaste"
                             TextChanged="SizeBoxChanged"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="2">
                <TextBlock Text="Пресеты"
                           FontSize="12"
                           Foreground="#68738A"
                           Margin="0,0,0,7"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/><ColumnDefinition Width="8"/>
                        <ColumnDefinition/><ColumnDefinition Width="8"/>
                        <ColumnDefinition/><ColumnDefinition Width="8"/>
                        <ColumnDefinition/><ColumnDefinition Width="8"/>
                        <ColumnDefinition/><ColumnDefinition Width="8"/>
                        <ColumnDefinition/><ColumnDefinition Width="8"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource Preset}" Tag="150|150" Click="Preset">
                        <StackPanel>
                            <TextBlock Text="XS" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="150 × 150" FontSize="11" Foreground="#68738A" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource Preset}" Tag="400|400" Click="Preset">
                        <StackPanel>
                            <TextBlock Text="S" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="400 × 400" FontSize="11" Foreground="#68738A" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="4" Style="{StaticResource Preset}" Tag="800|800" Click="Preset">
                        <StackPanel>
                            <TextBlock Text="M" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="800 × 800" FontSize="11" Foreground="#68738A" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="6" Style="{StaticResource Preset}" Tag="1280|720" Click="Preset">
                        <StackPanel>
                            <TextBlock Text="HD" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="1280 × 720" FontSize="11" Foreground="#68738A" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="8" Style="{StaticResource Preset}" Tag="1920|1080" Click="Preset">
                        <StackPanel>
                            <TextBlock Text="FullHD" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="1920 × 1080" FontSize="11" Foreground="#68738A" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="10" Style="{StaticResource Preset}" Tag="2560|1440" Click="Preset">
                        <StackPanel>
                            <TextBlock Text="2K" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="2560 × 1440" FontSize="11" Foreground="#68738A" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="12" Style="{StaticResource Preset}" Tag="3840|2160" Click="Preset">
                        <StackPanel>
                            <TextBlock Text="4K" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="3840 × 2160" FontSize="11" Foreground="#68738A" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>

            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <CheckBox x:Name="NoUpscaleCheck"
                          Style="{StaticResource OptionCheck}"
                          Content="Не увеличивать, если изображение меньше"
                          IsChecked="True"
                          Height="28"/>
                <CheckBox x:Name="ReplaceOriginalCheck"
                          Style="{StaticResource OptionCheck}"
                          Content="Заменять оригинал"
                          IsChecked="False"
                          Height="28"
                          Margin="24,0,0,0"/>
            </StackPanel>

            <Border Grid.Row="4" x:Name="DropCard"
                    Background="White" BorderBrush="#DDE3EC" BorderThickness="1"
                    CornerRadius="16" Cursor="Hand"
                    MouseLeftButtonDown="DropMouseDown"
                    AllowDrop="True"
                    DragEnter="DropDragEnter"
                    DragOver="DropDragOver"
                    Drop="DropFiles">
                <Border Margin="10" BorderBrush="#CDB3ED" BorderThickness="1.5"
                        CornerRadius="12" Background="#FEFBFF">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Перетащите изображение в эту область"
                                   FontSize="15" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="Status"
                                   Text="или просто нажмите сюда"
                                   FontSize="13" Foreground="#68738A"
                                   Margin="0,6,0,0" HorizontalAlignment="Center"/>
                        <TextBlock Text="JPG  ·  PNG  ·  WebP  ·  BMP  ·  TIFF"
                                   FontSize="11" Foreground="#8993A8"
                                   Margin="0,13,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Border>

            <Grid Grid.Row="5" Margin="18,18,18,0" Height="86" VerticalAlignment="Top">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="34"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- connecting line -->
                <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                        Height="1"
                        Background="#D9E2EF"
                        VerticalAlignment="Center"
                        Margin="52,0,52,0"/>

                <!-- step 1 -->
                <Border Grid.Row="0" Grid.Column="0"
                        Width="38" Height="38"
                        CornerRadius="19"
                        Background="#FFFFFF"
                        BorderBrush="#CDB3ED"
                        BorderThickness="1.5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Panel.ZIndex="1">
                    <TextBlock Text="1"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#7B2CC9"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="Задаем размер"
                           FontSize="12"
                           Foreground="#52647B"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <!-- step 2 -->
                <Border Grid.Row="0" Grid.Column="1"
                        Width="38" Height="38"
                        CornerRadius="19"
                        Background="#FFFFFF"
                        BorderBrush="#CDB3ED"
                        BorderThickness="1.5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Panel.ZIndex="1">
                    <TextBlock Text="2"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#7B2CC9"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Row="1" Grid.Column="1"
                           Text="Загружаем"
                           FontSize="12"
                           Foreground="#52647B"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <!-- step 3 -->
                <Border Grid.Row="0" Grid.Column="2"
                        Width="38" Height="38"
                        CornerRadius="19"
                        Background="#FFFFFF"
                        BorderBrush="#CDB3ED"
                        BorderThickness="1.5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Panel.ZIndex="1">
                    <TextBlock Text="3"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#7B2CC9"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Row="1" Grid.Column="2"
                           Text="Готово"
                           FontSize="12"
                           Foreground="#52647B"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>
        </Grid>

        <TextBlock Text="by Alexander Ryabov"
                   FontSize="10"
                   Foreground="#8993A8"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="0,0,4,4"
                   Cursor="Hand"
                   MouseLeftButtonUp="Author_Click"/>
    
        </Grid>
        </Grid>
    </Border>
</Window>