<Project Sdk="Microsoft.NET.Sdk">
<PropertyGroup>
<OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework><UseWPF>true</UseWPF>
<Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><PlatformTarget>x64</PlatformTarget>
<PublishSingleFile>true</PublishSingleFile><SelfContained>true</SelfContained><RuntimeIdentifier>win-x64</RuntimeIdentifier>
<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ApplicationIcon>rresizer.ico</ApplicationIcon>
</PropertyGroup>
<ItemGroup><PackageReference Include="SixLabors.ImageSharp" Version="3.1.11"/></ItemGroup>
<ItemGroup>
    <Resource Include="rresizer.ico" />
</ItemGroup>
</Project>